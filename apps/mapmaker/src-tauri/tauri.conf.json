{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Atlas Map Maker",
  "version": "../package.json",
  "identifier": "dev.atlas.mapmaker",
  "build": {
    "beforeDevCommand": "pnpm exec vite --port 1430 --strictPort",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atlas Map Maker",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "'self'",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Checks your own game files for map data",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../tools/gamefiles/LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
