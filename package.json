{
  "name": "atlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm demo:ensure && pnpm --filter @atlas/web dev",
    "build": "pnpm demo:ensure && pnpm --filter @atlas/web build",
    "preview": "pnpm --filter @atlas/web preview",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @atlas/web test:e2e",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "demo:ensure": "pnpm --filter @atlas/pipeline demo:ensure",
    "demo:build": "pnpm --filter @atlas/pipeline demo:build",
    "desktop:dev": "pnpm --filter @atlas/desktop dev",
    "desktop:build": "pnpm --filter @atlas/desktop build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
